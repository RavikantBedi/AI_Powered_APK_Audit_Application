# Copy this file to .env. Never commit .env.
# You can leave ALL keys empty and instead paste a key into the widget's
# settings panel (gear icon) — per-request keys override these.

# Default provider when a request doesn't specify one:
#   anthropic | gemini | groq | xai
LLM_PROVIDER=gemini

# Provider keys (only the one you use is needed)
# free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# free key: https://console.groq.com/keys
GROQ_API_KEY=
# https://console.x.ai (needs credits)
XAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
# DATABASE_URL=sqlite:///./agency.db   # swap to postgresql+psycopg://... later
# AGENT_MODEL=claude-opus-5            # Anthropic default model

# Email for weekly reports (Module 4). Leave unset to save reports to
# the reports/ folder only.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# REPORT_FROM=reports@youragency.com
